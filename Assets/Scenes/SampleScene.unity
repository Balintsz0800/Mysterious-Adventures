  m_Script: {fileID: 11500000, guid: 3f68b35ea417beb47b60c222432b3dd0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  dialogueUI: {fileID: 84640216}
  dialogueText: {fileID: 1094873076}
  dialogueSpeed: 0.03
  dialogues:
  - dialogueName: Person in the forest
    dialogueLines:
    - Hey! Excuse me, can I ask you something?
    - Sure. What do you need?
    - I'm new around here. The mayor sent me out to explore the area and get to know
      the surroundings.
    - Ah, I see. Well, you've come to a pretty quiet part of town.
    - Yeah, I've noticed. Do you live around here?
    - Not too far from here. I come to the forest quite often.
    - Is there anything interesting around here that I should know about?
    - Nothing too exciting. Although... I could use some help with something.
    - What happened?
    - I lost my bag somewhere around here.
    - You lost your bag?
    - Yeah. I had it with me when I came into the forest, but I can't remember where
      I left it.
    - Do you remember where you last saw it?
    - I think it was somewhere near that old tree.
    - Alright, I'll help you look for it. I might as well explore the area while
      I'm at it.
    - That would be great. Thanks!
    questRequirement: 0
    requiredQuest: {fileID: 0}
    givesQuest: 1
    questToGive: {fileID: 11400000, guid: 1ac3f85eacd631d498a17220f7b4ebfc, type: 2}
    completed: 0
  - dialogueName: Person in the forest
    dialogueLines:
    - You found it! I was looking everywhere for that.
    - It was lying near the old tree.
    - Thanks for bringing it back.
    - No problem.
    questRequirement: 3
    requiredQuest: {fileID: 11400000, guid: 1ac3f85eacd631d498a17220f7b4ebfc, type: 2}
    givesQuest: 0
    questToGive: {fileID: 0}
    completed: 0
  InteractDistance: 3
  inInteractionRange: 0
